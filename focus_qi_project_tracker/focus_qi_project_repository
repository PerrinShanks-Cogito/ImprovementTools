<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FOCUS improvement project tracker (mock)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#005EB8; --navy:#003087; --bg:#F0F4F5; --surface:#FFFFFF; --text:#212B32;
  --muted:#4C6272; --line:#D8DDE0; --yellow:#FFB81C; --green:#007F3B; --green-bg:#E3F2E9;
  --blue-bg:#E6F0FA; --danger:#D5281B; --shadow:0 2px 0 #D8DDE0;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --blue:#5AA2EA; --navy:#9CC3EF; --bg:#0E1A24; --surface:#162533; --text:#E8EEF2;
    --muted:#A3B6C3; --line:#2A3E4F; --green:#4CC17E; --green-bg:#143326; --blue-bg:#15314B;
    --danger:#FF7468; --shadow:0 2px 0 #0A131B;
  }
}
:root[data-theme="dark"]{
  --blue:#5AA2EA; --navy:#9CC3EF; --bg:#0E1A24; --surface:#162533; --text:#E8EEF2;
  --muted:#A3B6C3; --line:#2A3E4F; --green:#4CC17E; --green-bg:#143326; --blue-bg:#15314B;
  --danger:#FF7468; --shadow:0 2px 0 #0A131B;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font-family:Figtree,"Frutiger","Helvetica Neue",Arial,sans-serif;font-size:1rem;line-height:1.5}
a{color:var(--blue)}
:focus-visible{outline:3px solid var(--yellow);outline-offset:2px;border-radius:2px}
button,input,select,textarea{font:inherit;color:inherit}

/* Header */
.top{background:#005EB8;color:#fff}
.top-inner{max-width:1240px;margin:0 auto;padding:.9rem 1.25rem;display:flex;flex-wrap:wrap;gap:.75rem 1.5rem;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:baseline;gap:.6rem;color:#fff;text-decoration:none}
.brand b{font-size:1.25rem;font-weight:800;letter-spacing:-.01em}
.brand span{opacity:.85;font-size:.95rem}
.top nav{display:flex;flex-wrap:wrap;gap:.25rem}
.top nav a{color:#fff;text-decoration:none;padding:.4rem .7rem;border-radius:4px;font-weight:600;font-size:.95rem}
.top nav a:hover{background:rgba(255,255,255,.14)}
.top nav a[aria-current="page"]{background:#fff;color:#003087}
.support{background:#003087;color:#fff}
.support-inner{max-width:1240px;margin:0 auto;padding:.5rem 1.25rem;display:flex;flex-wrap:wrap;gap:.25rem 1.25rem;align-items:center;font-size:.92rem}
.support-inner strong{font-weight:600;opacity:.8;margin-right:.25rem}
.support a{color:#fff;text-underline-offset:3px}
.tools{position:relative}
.tools summary{cursor:pointer;list-style:none;text-decoration:underline;text-underline-offset:3px;display:inline-flex;align-items:center;gap:.35rem}
.tools summary::-webkit-details-marker{display:none}
.tools summary::after{content:"";width:.45rem;height:.45rem;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:translateY(-2px) rotate(45deg);transition:transform .15s}
.tools[open] summary::after{transform:translateY(2px) rotate(-135deg)}
.tools .menu{position:absolute;z-index:20;top:calc(100% + .5rem);left:0;width:min(380px,calc(100vw - 2.5rem));max-height:70vh;overflow:auto;background:var(--surface);color:var(--text);border:1px solid var(--line);border-radius:8px;box-shadow:0 12px 32px rgba(0,20,40,.25);padding:.4rem}
.toollist{list-style:none;margin:0;padding:0}
.toollist li{display:flex;justify-content:space-between;align-items:center;gap:.75rem;padding:.5rem .6rem;border-radius:4px}
.toollist li+li{border-top:1px solid var(--line)}
.toollist a{color:var(--blue);font-weight:600}
.toollist .off{color:var(--muted)}
.tag{flex:none;font-size:.78rem;font-weight:700;padding:.1rem .5rem;border-radius:99px;white-space:nowrap}
.tag.beta{background:var(--green-bg);color:var(--green)}
.tag.alpha{background:var(--blue-bg);color:var(--navy)}
.tag.dev{background:#FFF4DB;color:#6B4A00}
.tag.idea{background:var(--bg);color:var(--muted);border:1px solid var(--line)}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .tag.dev{background:#3A2E10;color:#FFD27A}}
:root[data-theme="dark"] .tag.dev{background:#3A2E10;color:#FFD27A}
.menu-note{font-size:.82rem;color:var(--muted);margin:.4rem .6rem .2rem}
.pdsa-add{display:grid;grid-template-columns:1fr auto;gap:.6rem;align-items:end}
.pdsa{list-style:none;margin:.9rem 0 0;padding:0;display:grid;gap:.5rem;counter-reset:c}
.pdsa li{counter-increment:c;display:grid;grid-template-columns:auto 1fr auto auto;gap:.75rem;align-items:center;padding:.55rem .8rem;border:1px solid var(--line);border-radius:4px}
.pdsa li::before{content:"Cycle " counter(c);font-weight:700;color:var(--blue);font-size:.9rem}
.pdsa .out{font-weight:700;font-size:.85rem;padding:.1rem .55rem;border-radius:99px}
.out.Adopted{background:var(--green-bg);color:var(--green)}
.out.Adapted{background:var(--blue-bg);color:var(--navy)}
.out.Abandoned{background:var(--bg);color:var(--danger);border:1px solid var(--line)}
@media (max-width:640px){.pdsa-add{grid-template-columns:1fr}.pdsa li{grid-template-columns:1fr auto}.pdsa li::before{grid-column:1/-1}}

main{max-width:1240px;margin:0 auto;padding:1.5rem 1.25rem 4rem}
.view[hidden]{display:none}

/* Project header */
.proj-head{display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-end;justify-content:space-between;margin-bottom:1.25rem}
.proj-head h1{margin:0;font-size:clamp(1.5rem,3vw,2rem);line-height:1.2;font-weight:800;letter-spacing:-.015em}
.proj-head .meta{color:var(--muted);margin:.25rem 0 0}
.pill{display:inline-block;font-size:.85rem;font-weight:600;padding:.15rem .6rem;border-radius:99px;background:var(--blue-bg);color:var(--navy)}
.pill.done{background:var(--green-bg);color:var(--green)}

/* FOCUS rail — the signature element */
.rail{display:grid;grid-template-columns:repeat(6,1fr);background:var(--surface);border:1px solid var(--line);border-radius:8px;overflow:hidden;margin-bottom:1.5rem;box-shadow:var(--shadow)}
.rail button{all:unset;cursor:pointer;position:relative;padding:1rem .9rem .9rem;border-right:1px solid var(--line);display:flex;flex-direction:column;gap:.15rem;min-width:0}
.rail button:last-child{border-right:0}
.rail button:focus-visible{outline:3px solid var(--yellow);outline-offset:-3px}
.rail .letter{font-size:clamp(2rem,5vw,3.6rem);font-weight:800;line-height:.9;color:var(--line);letter-spacing:-.03em;transition:color .2s}
.rail .name{font-weight:600;font-size:.92rem;line-height:1.25}
.rail .state{font-size:.82rem;color:var(--muted)}
.rail .done .letter{color:var(--green)}
.rail .current .letter{color:var(--blue)}
.rail .current{background:var(--blue-bg)}
.rail button[aria-selected="true"]::after{content:"";position:absolute;left:0;right:0;bottom:0;height:5px;background:var(--yellow)}
.rail button:hover .letter{color:var(--blue)}

/* Layout */
.work{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:1.5rem;align-items:start}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:1.5rem;box-shadow:var(--shadow)}
.panel h2{margin:0 0 .25rem;font-size:1.4rem;font-weight:700}
.panel .intro{margin:0 0 1.5rem;color:var(--muted);max-width:62ch}
.notice{background:var(--blue-bg);border-left:5px solid var(--blue);padding:.7rem 1rem;margin:0 0 1.5rem;border-radius:0 4px 4px 0}

.field{margin-bottom:1.35rem}
.field>label,.field>.lbl{display:block;font-weight:600;margin-bottom:.35rem}
.hint{display:block;color:var(--muted);font-size:.9rem;font-weight:400;margin:-.2rem 0 .4rem}
.req{color:var(--danger);font-weight:600}
input[type=text],input[type=email],input[type=url],input[type=date],select,textarea{
  width:100%;max-width:100%;padding:.55rem .7rem;border:2px solid var(--muted);border-radius:4px;background:var(--surface)}
textarea{min-height:6rem;resize:vertical;line-height:1.45}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--text);box-shadow:0 0 0 3px var(--yellow)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:0 1.25rem}
.seg{display:inline-flex;border:2px solid var(--muted);border-radius:4px;overflow:hidden}
.seg label{display:block;cursor:pointer}
.seg input{position:absolute;opacity:0;pointer-events:none}
.seg span{display:block;padding:.4rem 1.1rem;font-weight:600;border-right:1px solid var(--line)}
.seg label:last-child span{border-right:0}
.seg input:checked+span{background:var(--blue);color:#fff}
.seg input:focus-visible+span{box-shadow:inset 0 0 0 3px var(--yellow)}
.checks{display:flex;flex-wrap:wrap;gap:.5rem}
.checks label{display:flex;align-items:center;gap:.45rem;border:2px solid var(--line);border-radius:4px;padding:.35rem .7rem;cursor:pointer}
.checks input{width:1.15rem;height:1.15rem;accent-color:var(--blue)}
.checks label:has(input:checked){border-color:var(--blue);background:var(--blue-bg)}
fieldset{border:0;padding:0;margin:0}
.group-title{font-size:1.05rem;font-weight:700;margin:2rem 0 1rem;padding-top:1.25rem;border-top:1px solid var(--line)}

.log{list-style:none;margin:.75rem 0 0;padding:0;display:grid;gap:.6rem}
.log li{border-left:4px solid var(--blue);padding:.4rem .8rem;background:var(--bg);border-radius:0 4px 4px 0}
.log time{display:block;font-size:.85rem;color:var(--muted);font-weight:600}

.docs{margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--line)}
.docs h3{margin:0 0 .5rem;font-size:1.05rem}
.doclist{list-style:none;margin:.75rem 0 0;padding:0;display:grid;gap:.4rem}
.doclist li{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.45rem .75rem;border:1px solid var(--line);border-radius:4px;font-size:.95rem}
.doclist li span{overflow-wrap:anywhere}
.empty{color:var(--muted);font-size:.95rem;margin:.5rem 0 0}

.actions{display:flex;flex-wrap:wrap;gap:.75rem;align-items:center;margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--line)}
.btn{display:inline-flex;align-items:center;gap:.4rem;border:0;border-radius:4px;padding:.65rem 1.1rem;font-weight:700;cursor:pointer;background:var(--green);color:#fff;box-shadow:0 3px 0 #00401E;text-decoration:none}
.btn:active{transform:translateY(2px);box-shadow:0 1px 0 #00401E}
.btn.secondary{background:var(--surface);color:var(--blue);border:2px solid var(--blue);box-shadow:none;padding:.55rem 1rem}
.btn.quiet{background:transparent;color:var(--blue);box-shadow:none;padding:.4rem .5rem;text-decoration:underline;text-underline-offset:3px}
.btn.danger{color:var(--danger)}
.btn[disabled]{opacity:.45;cursor:not-allowed}
.saved{color:var(--muted);font-size:.9rem;margin-left:auto}

/* Aside */
aside .card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:1.1rem 1.2rem;margin-bottom:1rem;box-shadow:var(--shadow)}
aside h3{margin:0 0 .6rem;font-size:1rem}
aside dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:.35rem .8rem;font-size:.93rem}
aside dt{color:var(--muted)}
aside dd{margin:0;font-weight:600;overflow-wrap:anywhere}
.history{list-style:none;margin:0;padding:0;font-size:.92rem;display:grid;gap:.45rem}
.history li{display:flex;justify-content:space-between;gap:.5rem}
.history time{color:var(--muted)}
.helplinks{list-style:none;margin:0;padding:0;display:grid;gap:.5rem;font-size:.95rem}

/* Lists */
.listhead{display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;align-items:flex-end;margin-bottom:1rem}
.listhead h1{margin:0;font-size:clamp(1.5rem,3vw,2rem);font-weight:800;letter-spacing:-.015em}
.listhead p{margin:.25rem 0 0;color:var(--muted)}
.filters{display:flex;flex-wrap:wrap;gap:.6rem}
.filters input,.filters select{width:auto;min-width:12rem}
.tablewrap{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow)}
table{border-collapse:collapse;width:100%;min-width:760px;font-size:.95rem}
th,td{text-align:left;padding:.75rem 1rem;border-bottom:1px solid var(--line);vertical-align:top}
th{font-weight:700;background:var(--bg)}
tr:last-child td{border-bottom:0}
td .t{font-weight:600}
.mini{display:inline-flex;gap:2px;font-weight:800;font-size:1rem;letter-spacing:.02em}
.mini b{color:var(--line)}
.mini b.on{color:var(--green)}
.mini b.cur{color:var(--blue)}

/* Dialog */
dialog{border:0;border-radius:8px;padding:0;width:min(640px,calc(100% - 2rem));max-height:calc(100% - 2rem);background:var(--surface);color:var(--text);box-shadow:0 20px 60px rgba(0,20,40,.35)}
dialog::backdrop{background:rgba(0,30,60,.55)}
.dlg-head{padding:1.25rem 1.5rem 1rem;border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--surface);z-index:1}
.dlg-head h2{margin:0;font-size:1.3rem}
.dlg-head p{margin:.25rem 0 0;color:var(--muted)}
.dlg-body{padding:1.25rem 1.5rem}
.dlg-body ol{list-style:none;margin:0;padding:0;counter-reset:q}
.dlg-body li.q{counter-increment:q;display:grid;grid-template-columns:1.8rem 1fr;gap:.2rem .5rem;padding:.85rem 0;border-bottom:1px solid var(--line)}
.dlg-body li.q::before{content:counter(q);font-weight:800;color:var(--blue)}
.q .qtext{font-weight:600;margin-bottom:.45rem}
.q .sub{font-size:.92rem;color:var(--muted);margin:0 0 .5rem;padding-left:1rem}
.q .sub li{margin:.15rem 0}
.dlg-foot{padding:1rem 1.5rem 1.25rem;border-top:1px solid var(--line);display:flex;flex-wrap:wrap;gap:.75rem;justify-content:flex-end;position:sticky;bottom:0;background:var(--surface)}
.warn{color:var(--danger);font-weight:600;font-size:.92rem;margin:.75rem 0 0}

.toast{position:fixed;left:50%;bottom:calc(1.25rem + env(safe-area-inset-bottom,0px));transform:translate(-50%,150%);background:var(--navy);color:var(--surface);padding:.7rem 1.1rem;border-radius:6px;font-weight:600;transition:transform .25s;z-index:10;max-width:calc(100% - 2rem)}
.toast.show{transform:translate(-50%,0)}

@media (max-width:960px){.work{grid-template-columns:1fr}}
@media (max-width:640px){
  .grid2{grid-template-columns:1fr}
  .rail .name,.rail .state{display:none}
  .rail button{align-items:center;padding:.8rem .2rem}
  .panel{padding:1.1rem}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>

<header>
  <div class="top">
    <div class="top-inner">
      <a class="brand" href="#mine"><b>FOCUS</b><span>Improvement project tracker</span></a>
      <nav aria-label="Main">
        <a href="#mine" data-nav="mine">My projects</a>
        <a href="#project" data-nav="project">Current project</a>
        <a href="#repo" data-nav="repo">Project repository</a>
        <a href="#new" id="newProject">Start a new project</a>
      </nav>
    </div>
  </div>
  <div class="support">
    <div class="support-inner">
      <strong>Get support</strong>
      <a href="https://m365.cloud.microsoft/chat/?titleId=T_9a8ef1bb-12ee-5134-a332-f2a26e2f1bd9&source=embedded-builder" target="_blank" rel="noopener">QI Coach chatbot</a>
      <a href="https://nhs.sharepoint.com/:u:/r/sites/msteams_de9171/SitePages/Coaching,-Mentoring-%26-QI-Clinics.aspx?d=w388a701be9e940038a5ed1ab42b9b192&amp;csf=1&amp;web=1&amp;e=6gO0oF" target="_blank" rel="noopener">Book a QI Clinic</a>
      <details class="tools" id="toolsMenu"><summary>QI charting tools</summary><div class="menu"><ul class="toollist" id="toolsList"></ul><p class="menu-note">Tools still in development or ideation are listed so you know what is coming.</p></div></details>
    </div>
  </div>
</header>

<main>
  <!-- Project view -->
  <section class="view" id="view-project" hidden aria-labelledby="projTitle">
    <div class="proj-head">
      <div>
        <h1 id="projTitle">Untitled project</h1>
        <p class="meta" id="projMeta"></p>
      </div>
      <span class="pill" id="projStatus"></span>
    </div>

    <div class="rail" role="tablist" aria-label="FOCUS lifecycle stages" id="rail"></div>

    <div class="work">
      <div class="panel" id="panel"></div>
      <aside id="aside"></aside>
    </div>
  </section>

  <!-- My projects -->
  <section class="view" id="view-mine" aria-labelledby="mineTitle">
    <div class="listhead">
      <div><h1 id="mineTitle">My projects</h1><p>Projects where you are the submitter or project lead.</p></div>
      <a class="btn" href="#new">Start a new project</a>
    </div>
    <div class="tablewrap"><table id="mineTable"></table></div>
  </section>

  <!-- Repository -->
  <section class="view" id="view-repo" hidden aria-labelledby="repoTitle">
    <div class="listhead">
      <div><h1 id="repoTitle">Project repository</h1><p>Every improvement project registered across the Trust.</p></div>
      <div class="filters">
        <label class="visually-hidden" for="repoSearch" style="position:absolute;left:-9999px">Search projects</label>
        <input type="text" id="repoSearch" placeholder="Search by title, lead or team">
        <label for="repoStage" style="position:absolute;left:-9999px">Filter by stage</label>
        <select id="repoStage"><option value="">All stages</option></select>
      </div>
    </div>
    <div class="tablewrap"><table id="repoTable"></table></div>
  </section>
</main>

<dialog id="dlg" aria-labelledby="dlgTitle"></dialog>
<input type="file" id="fileInput" multiple hidden>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
const LINKS = {
  chatbot:"https://m365.cloud.microsoft/chat/?titleId=T_9a8ef1bb-12ee-5134-a332-f2a26e2f1bd9&source=embedded-builder",
  priorities:"https://intranet.gstt.nhs.uk/clinical-services/how-we-keep-patients-safe-and-improve-our-care/our-improvement-priorities/",
  girft:"https://gettingitrightfirsttime.co.uk/",
  modelHospital:"https://model.nhs.uk/"
};

const TOOLS = [
 {n:"Driver diagram",url:"https://github.com/PerrinShanks-Cogito/ImprovementTools/tree/main/driver_diagram",s:"Ready for beta",c:"beta"},
 {n:"Pareto chart",url:"https://paretochartbuilder.netlify.app/",s:"Beta, published",c:"beta"},
 {n:"Run chart",url:"https://runchartbuilder.netlify.app/",s:"Beta, published",c:"beta"},
 {n:"SPC tool",url:"https://spc-tool.netlify.app/",s:"Alpha, published",c:"alpha"},
 {n:"Scatter plot",s:"In development",c:"dev"},
 {n:"Bar chart",s:"In development",c:"dev"},
 {n:"Fishbone",s:"In ideation",c:"idea"},
 {n:"A3 poster generator",s:"In ideation",c:"idea"},
 {n:"Histogram",s:"In ideation",c:"idea"},
 {n:"PDSA snapshot generator",s:"In ideation",c:"idea"},
 {n:"Regression analysis tool",s:"In ideation",c:"idea"},
 {n:"Three factor test design matrix",s:"In ideation",c:"idea"}
];
const toolItem = t => `<li>${t.url?`<a href="${t.url}" target="_blank" rel="noopener">${t.n}</a>`:`<span class="off">${t.n}</span>`}<span class="tag ${t.c}">${t.s}</span></li>`;

const OPTS = {
  group:["Cancer and Surgery","Evelina London Children's","Integrated and Specialist Medicine","Heart, Lung and Critical Care","Diagnostics and Pharmacy","Essentia","Finance","People","Digital Services","Corporate Nursing","Other corporate team"],
  domain:["Safe","Effective","Patient-centred","Timely","Efficient","Equitable"],
  submission:["Improvement idea","QI project","Part of a QI programme","QI fellowship or training project","Other"],
  profession:["Nursing and midwifery","Medical and dental","Allied health professional","Healthcare scientist","Pharmacy","Administrative and clerical","Estates and facilities","Management","Other"],
  sites:["St Thomas'","Guy's","Royal Brompton","Harefield","Evelina"],
  status:["Completed","Closed, not progressed","On hold","Merged with another project"],
  scalable:["Yes","No","Not sure"],
  realised:["Yes","Partially","No","Too early to tell"],
  pdsaOutcome:["Adopted","Adapted","Abandoned"]
};

const STAGES = [
 {id:"find",letter:"F",name:"Find the opportunity",
  intro:"Tell us what you want to improve, why it matters and who is involved.",
  fields:[
   {k:"title",t:"text",l:"Project title",req:true},
   {k:"description",t:"textarea",l:"Briefly describe the project"},
   {k:"expectedBenefits",t:"textarea",l:"Expected benefits",hint:"What will be better if this works, and for whom?"},
   {row:[{k:"group",t:"select",l:"Clinical group / corporate team",o:"group"},{k:"domain",t:"select",l:"Quality domain",o:"domain"}]},
   {k:"submissionType",t:"select",l:"Submission type",o:"submission"},
   {h:"People"},
   {k:"submitter",t:"text",l:"Your name",hint:"The person submitting this project."},
   {row:[{k:"leadName",t:"text",l:"Project lead name"},{k:"leadEmail",t:"email",l:"Project lead email"}]},
   {k:"profession",t:"select",l:"Project lead professional group",o:"profession"},
   {row:[{k:"sponsor",t:"text",l:"Line manager / sponsor"},{k:"coach",t:"text",l:"Project coach / advisor"}]},
   {k:"collaborators",t:"textarea",l:"QI collaborators",hint:"Anyone else working on the project with you. Add names and teams, one per line."},
   {k:"sponsorSupport",t:"yesno",l:"Does your line manager / sponsor support the project?"},
   {h:"Where"},
   {k:"sites",t:"checks",l:"Project sites",o:"sites"}
  ],
