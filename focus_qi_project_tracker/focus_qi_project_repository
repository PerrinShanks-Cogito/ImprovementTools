/* ---------- Checklist dialog ---------- */
const dlg=document.getElementById("dlg");
function openChecklist(){
  const p=cur(), s=STAGES[p.stage], next=Math.min(p.stage+1,STAGES.length-1);
  const yn=(k)=>`<div class="seg">${["Yes","No"].map(o=>`<label><input type="radio" name="c_${k}" data-ck="${k}" value="${o}"${p.data[k]===o?" checked":""}><span>${o}</span></label>`).join("")}</div>`;
  dlg.innerHTML = `
   <div class="dlg-head"><h2 id="dlgTitle">Ready to move on from ${s.name}?</h2><p>Check you have covered the essentials before moving to the next FOCUS stage.</p></div>
   <div class="dlg-body"><ol>
     ${s.checklist.map(c=>`<li class="q"><div><div class="qtext">${esc(c.q)}</div>
       ${c.note?`<p class="sub" style="padding-left:0">${esc(c.note)}</p>`:""}
       ${c.links?`<ul class="sub">${c.links.map(([t,u])=>`<li><a href="${u}" target="_blank" rel="noopener">${esc(t)}</a></li>`).join("")}</ul>`:""}
       ${yn(c.k)}</div></li>`).join("")}
     <li class="q"><div><div class="qtext">Ready to move to the next stage?</div>${yn("ckReady_"+s.id)}</div></li>
     <li class="q"><div><label class="qtext" for="ckDate" style="display:block">Date of lifecycle change</label><input type="date" id="ckDate" value="${today()}"></div></li>
     <li class="q"><div><label class="qtext" for="ckStage" style="display:block">New lifecycle stage</label>
       <select id="ckStage">${STAGES.map((x,i)=>`<option value="${i}"${i===next?" selected":""}>${x.name}</option>`).join("")}</select></div></li>
   </ol><p class="warn" id="ckWarn" hidden></p></div>
   <div class="dlg-foot"><button type="button" class="btn secondary" data-act="dlgCancel">Not yet</button><button type="button" class="btn" data-act="dlgConfirm">Move to ${STAGES[next].name}</button></div>`;
  dlg.showModal();
}
dlg.addEventListener("change",e=>{
  const p=cur();
  if(e.target.dataset.ck){ p.data[e.target.dataset.ck]=e.target.value; saveSoon(); }
  if(e.target.id==="ckStage") dlg.querySelector('[data-act="dlgConfirm"]').textContent="Move to "+STAGES[+e.target.value].name;
});
dlg.addEventListener("click",e=>{
  const a=e.target.closest("[data-act]")?.dataset.act;
  if(e.target===dlg || a==="dlgCancel"){ dlg.close(); return; }
  if(a==="dlgConfirm"){
    const p=cur(), s=STAGES[p.stage], warn=dlg.querySelector("#ckWarn");
    const target=+dlg.querySelector("#ckStage").value, date=dlg.querySelector("#ckDate").value;
    let msg="";
    if(p.data["ckReady_"+s.id]!=="Yes") msg="Answer yes to \u201cReady to move to the next stage?\u201d to continue.";
    else if(!date) msg="Enter the date of the lifecycle change.";
    else if(target===p.stage) msg="Choose a different lifecycle stage.";
    else if(s.id==="find" && !p.data.title) msg="Add a project title before moving on.";
    if(msg){ warn.textContent=msg; warn.hidden=false; return; }
    p.stage=target; p.history.push({stage:target,date}); viewStage=target;
    save(); dlg.close(); renderProject(); toast("Moved to "+STAGES[target].name);
    window.scrollTo({top:0,behavior:"smooth"});
  }
});

/* ---------- Panel events ---------- */
const panel=document.getElementById("panel");
function onField(e){
  const el=e.target, k=el.dataset.k; if(!k) return;
  const p=cur();
  if(el.type==="checkbox"){
    p.data[k]=[...panel.querySelectorAll(`input[data-k="${k}"]:checked`)].map(i=>i.value);
  } else p.data[k]=el.value;
  if(k==="title"||k==="leadName"||k==="group"){ document.getElementById("projTitle").textContent=p.data.title||"Untitled project";
    document.getElementById("projMeta").textContent=[p.data.leadName&&("Led by "+p.data.leadName),p.data.group,"Started "+fmt(p.created)].filter(Boolean).join(", "); }
  saveSoon(); if(e.type==="change") renderAside();
}
panel.addEventListener("input",onField);
panel.addEventListener("change",onField);

const fileInput=document.getElementById("fileInput");
fileInput.addEventListener("change",()=>{
  const p=cur(), sid=STAGES[viewStage].id;
  p.docs[sid]=(p.docs[sid]||[]).concat([...fileInput.files].map(f=>f.name));
  const n=fileInput.files.length; fileInput.value="";
  save(); renderProject(); toast(n+" document"+(n>1?"s":"")+" added");
});

panel.addEventListener("click",e=>{
  const b=e.target.closest("[data-act]"); if(!b) return;
  const p=cur(), sid=STAGES[viewStage].id;
  switch(b.dataset.act){
    case "addDocs": fileInput.click(); break;
    case "rmDoc": p.docs[sid].splice(+b.dataset.i,1); save(); renderProject(); toast("Document removed"); break;
    case "checklist": openChecklist(); break;
    case "addUpdate":{
      const ta=document.getElementById("f_updates"), txt=ta.value.trim();
      if(!txt){ ta.focus(); toast("Write your update first"); return; }
      (p.data.updates=p.data.updates||[]).push({date:today(),text:txt}); save(); renderProject(); toast("Update added"); break;}
    case "addPdsa":{
      const inp=document.getElementById("pdsaChange"), txt=inp.value.trim();
      if(!txt){ inp.focus(); toast("Describe what the cycle changed first"); return; }
      const out=panel.querySelector('input[name="pdsaOut"]:checked').value;
      (p.data.pdsa=p.data.pdsa||[]).push({change:txt,outcome:out});
      if(!p.data.pdsaCount || +p.data.pdsaCount<p.data.pdsa.length) p.data.pdsaCount=String(p.data.pdsa.length);
      save(); renderProject(); toast("PDSA cycle added"); break;}
    case "rmPdsa": p.data.pdsa.splice(+b.dataset.i,1); save(); renderProject(); toast("PDSA cycle removed"); break;
    case "closeProject":
      if(!p.data.status||!p.data.completionDate){ toast("Add a project status and completion date to close"); return; }
      p.closed=true; p.stage=5; p.history.push({stage:5,date:p.data.completionDate}); save(); renderProject(); toast("Project closed"); break;
    case "reopen": p.closed=false; save(); renderProject(); toast("Project reopened"); break;
  }
});

document.getElementById("rail").addEventListener("click",e=>{
  const b=e.target.closest("[data-stage]"); if(!b) return;
  viewStage=+b.dataset.stage; renderProject(); document.getElementById("tab_"+STAGES[viewStage].id).focus();
});
document.getElementById("rail").addEventListener("keydown",e=>{
  if(!["ArrowLeft","ArrowRight"].includes(e.key)) return;
  viewStage=(viewStage+(e.key==="ArrowRight"?1:-1)+STAGES.length)%STAGES.length;
  renderProject(); document.getElementById("tab_"+STAGES[viewStage].id).focus();
});

/* ---------- Lists ---------- */
function miniRail(p){
  return `<span class="mini" aria-label="${esc(stageLabel(p))}">${STAGES.map((s,i)=>`<b class="${p.closed||i<p.stage?"on":(i===p.stage?"cur":"")}">${s.letter}</b>`).join("")}</span>`;
}
function rows(list,mine){
  if(!list.length) return `<tbody><tr><td colspan="6"><p class="empty">No projects match. Try a different search or stage.</p></td></tr></tbody>`;
  return `<thead><tr><th>Project</th><th>Lifecycle</th><th>Stage</th><th>Team</th><th>Sites</th><th>${mine?"Last change":"Lead"}</th></tr></thead><tbody>${
    list.map(p=>{const d=p.data,last=p.history[p.history.length-1];
      return `<tr><td><a class="t" href="#project" data-open="${p.id}">${esc(d.title||"Untitled project")}</a><div class="hint" style="margin:0">${esc((d.expectedBenefits||"").slice(0,90))}</div></td>
      <td>${miniRail(p)}</td><td>${esc(stageLabel(p))}</td><td>${esc(d.group||"")}</td><td>${esc((d.sites||[]).join(", "))}</td>
      <td>${mine?fmt(last.date):esc(d.leadName||"")}</td></tr>`}).join("")}</tbody>`;
}
function renderMine(){ document.getElementById("mineTable").innerHTML=rows(S.projects.filter(p=>p.owner===ME),true); }
function renderRepo(){
  const q=document.getElementById("repoSearch").value.toLowerCase(), st=document.getElementById("repoStage").value;
  const list=S.projects.filter(p=>{
    const hay=[p.data.title,p.data.leadName,p.data.group].join(" ").toLowerCase();
    const sv=p.closed?"closed":String(p.stage);
    return (!q||hay.includes(q)) && (!st||st===sv);
  });
  document.getElementById("repoTable").innerHTML=rows(list,false);
}
document.getElementById("repoStage").innerHTML+=STAGES.slice(0,5).map((s,i)=>`<option value="${i}">${s.name}</option>`).join("")+`<option value="closed">Closed</option>`;
document.getElementById("repoSearch").addEventListener("input",renderRepo);
document.getElementById("repoStage").addEventListener("change",renderRepo);
document.addEventListener("click",e=>{
  const o=e.target.closest("[data-open]");
  if(o){ S.current=o.dataset.open; viewStage=cur().closed?5:cur().stage; save(); }
  const ph=e.target.closest("[data-placeholder]");
  if(ph){ e.preventDefault(); toast("Mock link: this will open the "+ph.dataset.placeholder); }
});

/* ---------- Routing ---------- */
function route(){
  let h=(location.hash||"#mine").slice(1);
  if(h==="new"){
    const p=blankProject(); S.projects.unshift(p); S.current=p.id; viewStage=0; save();
    history.replaceState(null,"","#project"); h="project"; toast("New project started");
  }
  if(!["project","mine","repo"].includes(h)) h="mine";
  document.querySelectorAll(".view").forEach(v=>v.hidden=v.id!=="view-"+h);
  document.querySelectorAll("[data-nav]").forEach(a=>a.toggleAttribute("aria-current",a.dataset.nav===h) || a.removeAttribute("aria-current"));
  document.querySelectorAll("[data-nav]").forEach(a=>{ if(a.dataset.nav===h) a.setAttribute("aria-current","page"); });
  if(h==="project") renderProject(); if(h==="mine") renderMine(); if(h==="repo") renderRepo();
  window.scrollTo(0,0);
}
document.getElementById("toolsList").innerHTML=TOOLS.map(toolItem).join("");
const toolsMenu=document.getElementById("toolsMenu");
document.addEventListener("click",e=>{ if(toolsMenu.open && !toolsMenu.contains(e.target)) toolsMenu.open=false; });
document.addEventListener("keydown",e=>{ if(e.key==="Escape" && toolsMenu.open){ toolsMenu.open=false; toolsMenu.querySelector("summary").focus(); } });
window.addEventListener("hashchange",route);
route();
</script>
</body>
</html>
