/* ---------- Helpers ---------- */
const esc = s => String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmt = d => d ? new Date(d+"T00:00").toLocaleDateString("en-GB",{day:"numeric",month:"short",year:"numeric"}) : "";
function toast(msg){ const t=document.getElementById("toast"); t.textContent=msg; t.classList.add("show"); clearTimeout(t._h); t._h=setTimeout(()=>t.classList.remove("show"),2600); }
function stageLabel(p){ return p.closed ? "Closed" : STAGES[p.stage].name; }

/* ---------- Field rendering ---------- */
function fieldHTML(f,d){
  if(f.h) return `<h3 class="group-title">${esc(f.h)}</h3>`;
  if(f.row) return `<div class="grid2">${f.row.map(x=>fieldHTML(x,d)).join("")}</div>`;
  const id="f_"+f.k, v=d[f.k];
  const lab=`${esc(f.l)}${f.req?' <span class="req" aria-hidden="true">*</span>':''}`;
  const hint=f.hint?`<span class="hint" id="${id}_h">${esc(f.hint)}</span>`:"";
  const desc=f.hint?` aria-describedby="${id}_h"`:"";
  switch(f.t){
    case "text": case "email": case "url": case "date":
      return `<div class="field"><label for="${id}">${lab}</label>${hint}<input type="${f.t}" id="${id}" data-k="${f.k}" value="${esc(v)}"${desc}${f.req?" required":""}></div>`;
    case "textarea":
      return `<div class="field"><label for="${id}">${lab}</label>${hint}<textarea id="${id}" data-k="${f.k}"${desc}>${esc(v)}</textarea></div>`;
    case "select":
      return `<div class="field"><label for="${id}">${lab}</label>${hint}<select id="${id}" data-k="${f.k}"${desc}><option value="">Select an option</option>${OPTS[f.o].map(o=>`<option${o===v?" selected":""}>${esc(o)}</option>`).join("")}</select></div>`;
    case "yesno": case "radio3":
      const opts = f.t==="yesno"?["Yes","No"]:OPTS[f.o];
      return `<fieldset class="field"><legend class="lbl" style="font-weight:600;margin-bottom:.35rem">${lab}</legend>${hint}<div class="seg">${opts.map(o=>`<label><input type="radio" name="${id}" data-k="${f.k}" value="${o}"${v===o?" checked":""}><span>${o}</span></label>`).join("")}</div></fieldset>`;
    case "checks":
      const arr=v||[];
      return `<fieldset class="field"><legend class="lbl" style="font-weight:600;margin-bottom:.35rem">${lab}</legend><div class="checks">${OPTS[f.o].map(o=>`<label><input type="checkbox" data-k="${f.k}" value="${esc(o)}"${arr.includes(o)?" checked":""}>${esc(o)}</label>`).join("")}</div></fieldset>`;
    case "number":
      return `<div class="field"><label for="${id}">${lab}</label>${hint}<input type="number" min="0" step="1" inputmode="numeric" id="${id}" data-k="${f.k}" value="${esc(v)}" style="max-width:8rem"${desc}></div>`;
    case "pdsa":{
      const cyc=v||[];
      return `<fieldset class="field"><legend class="lbl" style="font-weight:600;margin-bottom:.35rem">${lab}</legend>${hint}
        <div class="pdsa-add"><div><label for="pdsaChange" class="hint" style="margin:0 0 .3rem">What did this cycle change?</label><input type="text" id="pdsaChange" placeholder="For example: added a pharmacy prompt at the 10am huddle"></div>
        <div><span class="hint" style="margin:0 0 .3rem">Outcome</span><div class="seg" role="radiogroup" aria-label="Outcome">${OPTS.pdsaOutcome.map((o,i)=>`<label><input type="radio" name="pdsaOut" value="${o}"${i===0?" checked":""}><span>${o.replace("ed","")}</span></label>`).join("")}</div></div></div>
        <div style="margin-top:.6rem"><button type="button" class="btn secondary" data-act="addPdsa">Add PDSA cycle</button></div>
        ${cyc.length?`<ol class="pdsa">${cyc.map((c,i)=>`<li><span>${esc(c.change)}</span><span class="out ${c.outcome}">${c.outcome}</span><button type="button" class="btn quiet danger" data-act="rmPdsa" data-i="${i}" aria-label="Remove cycle ${i+1}">Remove</button></li>`).join("")}</ol>`:`<p class="empty">No PDSA cycles listed yet.</p>`}</fieldset>`;}
    case "log":
      const list=(v||[]).slice().reverse();
      return `<div class="field"><label for="${id}">${lab}</label><span class="hint">Add a dated note each time you test a change or reach a milestone.</span>
        <textarea id="${id}" placeholder="What did you test, what happened, what will you do next?"></textarea>
        <div style="margin-top:.6rem"><button type="button" class="btn secondary" data-act="addUpdate">Add update</button></div>
        ${list.length?`<ul class="log">${list.map(u=>`<li><time>${fmt(u.date)}</time>${esc(u.text)}</li>`).join("")}</ul>`:`<p class="empty">No updates yet. Your first update will appear here.</p>`}</div>`;
  }
}

/* ---------- Render: project ---------- */
function renderProject(){
  const p=cur(), d=p.data;
  document.getElementById("projTitle").textContent = d.title || "Untitled project";
  document.getElementById("projMeta").textContent = [d.leadName&&("Led by "+d.leadName), d.group, "Started "+fmt(p.created)].filter(Boolean).join(", ");
  const st=document.getElementById("projStatus");
  st.textContent = p.closed ? "Closed" : "Current stage: "+STAGES[p.stage].name;
  st.className = "pill"+(p.closed?" done":"");

  document.getElementById("rail").innerHTML = STAGES.map((s,i)=>{
    const done = p.closed || i<p.stage, current = !p.closed && i===p.stage;
    const stTxt = done?"Complete":current?"In progress":"Not started";
    return `<button role="tab" id="tab_${s.id}" aria-controls="panel" aria-selected="${i===viewStage}" class="${done?"done":current?"current":""}" data-stage="${i}">
      <span class="letter" aria-hidden="true">${s.letter}</span><span class="name">${s.name}</span><span class="state">${stTxt}</span>
      <span style="position:absolute;left:-9999px">${s.name}, ${stTxt}</span></button>`;
  }).join("");

  const s=STAGES[viewStage];
  const isCurrent = !p.closed && viewStage===p.stage;
  let notice="";
  if(p.closed) notice=`<p class="notice">This project is closed. You can still view and update the record.</p>`;
  else if(viewStage>p.stage) notice=`<p class="notice">This project is at <strong>${STAGES[p.stage].name}</strong>. You can start filling this stage in early.</p>`;
  else if(viewStage<p.stage) notice=`<p class="notice">This stage is complete. Changes here update the project record.</p>`;

  const docs=p.docs[s.id]||[];
  let action="";
  if(s.id==="close"){
    action = p.closed
      ? `<button type="button" class="btn secondary" data-act="reopen">Reopen project</button>`
      : `<button type="button" class="btn" data-act="closeProject">Close project</button>`;
  } else if(isCurrent){
    action = `<button type="button" class="btn" data-act="checklist">Ready to move on</button>`;
  }

  document.getElementById("panel").setAttribute("aria-labelledby","tab_"+s.id);
  document.getElementById("panel").innerHTML = `
    <h2>${s.name}</h2><p class="intro">${s.intro}</p>${notice}
    <form id="stageForm" onsubmit="return false" novalidate>${s.fields.map(f=>fieldHTML(f,p.data)).join("")}</form>
    <div class="docs"><h3>${s.docsLabel||"Documents"}</h3>
      <button type="button" class="btn secondary" data-act="addDocs">Add documents</button>
      ${docs.length?`<ul class="doclist">${docs.map((n,i)=>`<li><span>${esc(n)}</span><button type="button" class="btn quiet danger" data-act="rmDoc" data-i="${i}" aria-label="Remove ${esc(n)}">Remove</button></li>`).join("")}</ul>`:`<p class="empty">No documents added to this stage yet.</p>`}
    </div>
    <div class="actions">${action}<span class="saved" id="savedNote">Changes save automatically</span></div>`;

  renderAside();
}

